APARTMENT_DB_PASSWORD=replace_with_random_password
NODE_ENV=development
HOST=0.0.0.0
PORT=8088
DATABASE_URL=postgres://apartment:change_me@127.0.0.1:55432/apartment
LINE_CHANNEL_ID=
LINE_LIFF_ID=
COOKIE_SECURE=true
WEB_ORIGIN=https://apartme.makemarket.space
SUPER_ADMIN_LINE_USER_ID=

# P3 private development-only payment-evidence directory; must never be publicly served
PAYMENT_EVIDENCE_DIR=


# P3 private evidence storage: default local in development
EVIDENCE_STORAGE_DRIVER=local
# For S3-compatible provider set s3 and these values (do NOT commit real secrets):
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_FORCE_PATH_STYLE=false
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=

# P3 optional ClamAV scanner (disabled means NOT SCANNED in DEV)
EVIDENCE_MALWARE_SCANNER=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
\n# LINE OA P4: disabled until valid Messaging API channel & consent testing\nLINE_MESSAGING_CHANNEL_SECRET=\nLINE_MESSAGING_CHANNEL_ACCESS_TOKEN=\nLINE_OA_BOT_USER_ID=\nLINE_OUTBOUND_MODE=disabled\n
# P4-03c safe observer; do not enable LIVE in DEV.
LINE_WORKER_MODE=observe
LINE_WORKER_APPROVED=false
LINE_WORKER_INTERVAL_MS=60000

# P4-03d conservative internal attempt budget (NOT a LINE provider quota)
LINE_GLOBAL_PER_MINUTE=20
LINE_ORG_PER_MINUTE=5
