[Unit]
Description=Apartment same-VPS encrypted PostgreSQL archive
After=apartment-postgres-backup.service
OnFailure=apartment-backup-alert@%n.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/bash /root/Projects/Apartment/infra/local-archive-apartment-postgres.sh archive
TimeoutStartSec=10min
NoNewPrivileges=true
