{
  "name": "apartment-platform",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "scripts": {
    "dev:api": "corepack pnpm --filter @apartment/api dev",
    "dev:web": "corepack pnpm --filter @apartment/web dev",
    "test": "corepack pnpm --filter @apartment/domain test && corepack pnpm --filter @apartment/api test",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm exec eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" --max-warnings=0",
    "coverage:api": "corepack pnpm --filter @apartment/api exec vitest run --coverage --coverage.include=\"src/**/*.ts\" --coverage.reporter=text-summary",
    "coverage:domain": "corepack pnpm --filter @apartment/domain exec vitest run --coverage --coverage.include=\"src/**/*.ts\" --coverage.reporter=text-summary",
    "db:generate": "corepack pnpm --filter @apartment/api db:generate",
    "db:migrate": "corepack pnpm --filter @apartment/api db:migrate",
    "test:e2e": "corepack pnpm --filter @apartment/web build && corepack pnpm exec playwright test",
    "coverage:api:postgres": "bash infra/test-api-postgres-coverage.sh",
    "test:e2e:postgres": "APARTMENT_POSTGRES_BROWSER=only bash infra/test-api-postgres-coverage.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "3.2.7",
    "c8": "10.1.3",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.72.1"
  }
}
